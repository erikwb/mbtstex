\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{mbts-bible}[2026/10/20 MBTS Scripture references]
\RequirePackage{xparse}
\newcommand*\mbtsdeclarebiblebook[2]{\expandafter\def\csname mbtsbook@#1\endcsname{#2}}
\newcommand*\mbtsbook[1]{\ifcsname mbtsbook@#1\endcsname
  \csname mbtsbook@#1\endcsname\else
  \PackageError{mbts-bible}{Unknown Bible book '#1'}{Use the full English name,
    or register a name with \string\mbtsdeclarebiblebook.}\fi}
\NewDocumentCommand\mbtsbibleref{O{} m m}{\mbtsbook{#2}\ #3\if\relax\detokenize{#1}\relax\else\ #1\fi}
\NewDocumentCommand\mbtsbible{O{} m m}{(\mbtsbibleref[#1]{#2}{#3})}
\NewDocumentCommand\mbtsbiblefootnote{O{} m m}{\footnote{\mbtsbibleref[#1]{#2}{#3}.}}
\newcommand\mbtsbibleversion[5]{\footnote{Unless otherwise indicated, all Scripture
  quotations are from the \textit{#1} (#2) (#3: #4, #5).}}
