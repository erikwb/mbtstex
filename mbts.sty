\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{mbts}[2026/10/20 v0.2.0 Midwestern fourth-edition formatting]
% Midwestern Style Manual, fourth edition (2021). See docs/coverage.md.
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=mbts,prefix=mbts@}
\DeclareStringOption[auto]{font}
\DeclareStringOption[10]{footnotesize}
\DeclareBoolOption[false]{dissertation}
\DeclareBoolOption[false]{submission}
\DeclareBoolOption[false]{fifthlevel}
\DeclareBoolOption[false]{review}
\ProcessKeyvalOptions*
\RequirePackage{etoolbox}
\RequirePackage{iftex}

\ifmbts@dissertation
  \@ifclassloaded{report}{}{\PackageError{mbts}{Dissertations require report class}%
    {Use \string\documentclass[dissertation]{mbts}.}}
\else
  \@ifclassloaded{article}{}{\PackageError{mbts}{Course papers require article class}%
    {Use the mbts class, or dissertation with report.}}
\fi
\ifmbts@submission\def\mbts@font{times}\fi
\ifdefstring{\mbts@footnotesize}{10}{}{\PackageError{mbts}{Footnotes must be 10pt}%
  {The fourth edition changed footnotes from 12pt to 10pt.}}
\ifnum\@ptsize=2\else
  \PackageError{mbts}{A 12pt document class is required}%
    {Use \string\documentclass{mbts} or \string\documentclass[12pt]{article}.}
\fi
\if@twocolumn
  \PackageError{mbts}{Two-column layout is unsupported}{Use a one-column article.}
\fi

% Font substitution is explicit. font=times makes the required font mandatory.
\newcommand*\mbts@fontwarning{%
  \PackageWarningNoLine{mbts}{Using TeX Gyre Termes, NOT Times New Roman.\MessageBreak
    For submission use LuaLaTeX or XeLaTeX with Times New Roman\MessageBreak
    installed and font=times. See README.md}}
\newcommand*\mbts@termes{%
  \ifPDFTeX
    \RequirePackage[T1]{fontenc}
    \RequirePackage{tgtermes}
  \else
    \RequirePackage{fontspec}
    \setmainfont{texgyretermes}[Extension=.otf,
      UprightFont=*-regular,ItalicFont=*-italic,
      BoldFont=*-bold,BoldItalicFont=*-bolditalic]
  \fi
  \mbts@fontwarning}
\newcommand*\mbts@times{%
  \ifPDFTeX
    \PackageError{mbts}{font=times requires LuaLaTeX or XeLaTeX}%
      {Change compiler, or use font=termes for a draft.}
  \else
    \RequirePackage{fontspec}
    \IfFontExistsTF{Times New Roman}{\setmainfont{Times New Roman}}{%
      \PackageError{mbts}{Times New Roman is not installed}%
        {Install a licensed copy, or use font=termes for a draft.}}
  \fi}
\ifdefstring{\mbts@font}{auto}{%
  \ifPDFTeX
    \mbts@termes
  \else
    \RequirePackage{fontspec}
    \IfFontExistsTF{Times New Roman}{\setmainfont{Times New Roman}}{\mbts@termes}
  \fi
}{\ifdefstring{\mbts@font}{times}{\mbts@times}{%
  \ifdefstring{\mbts@font}{termes}{\mbts@termes}{%
    \ifdefstring{\mbts@font}{none}{}{%
      \PackageError{mbts}{Unknown font option '\mbts@font'}%
        {Choose auto, times, termes, or none.}}}}}

\RequirePackage[letterpaper,margin=1in,footskip=.5in]{geometry}
\ifmbts@dissertation\geometry{left=1.5in}\fi
\RequirePackage{setspace}
\RequirePackage[bottom,splitrule]{footmisc}
\RequirePackage[largestsep]{titlesec}
\RequirePackage{indentfirst}

% Public lengths can be overridden in the preamble for assignment variations.
\newlength\mbtsindent
\setlength\mbtsindent{.5in}
\newlength\mbtssinglebaseline
\setlength\mbtssinglebaseline{14.4pt}
\newlength\mbtsheadbefore
\setlength\mbtsheadbefore{2\mbtssinglebaseline}
\newlength\mbtsheadafter
\setlength\mbtsheadafter{\mbtssinglebaseline}
\newlength\mbts@bodybaseline
\setlength\mbts@bodybaseline{24pt}
\newlength\mbtsentrysep
\setlength\mbtsentrysep{\mbtssinglebaseline}
\newlength\mbtstitlebaseline
\setlength\mbtstitlebaseline{13.8pt}
\newlength\mbtsfootnoterulewidth
% Conventional short separator; the fourth edition does not specify its width.
\AtBeginDocument{%
  \ifdim\mbtsfootnoterulewidth=0pt
    \setlength\mbtsfootnoterulewidth{\fontdimen2\font}%
    \multiply\mbtsfootnoterulewidth by 22
  \fi}

\def\ps@mbts{%
  \let\@oddhead\@empty\let\@evenhead\@empty
  \def\@oddfoot{\hfil\normalfont\normalsize\thepage\hfil}%
  \let\@evenfoot\@oddfoot}
\let\ps@plain\ps@mbts
\pagestyle{mbts}

% Four unnumbered levels, retaining normal LaTeX section/TOC semantics.
\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{1}
\titleformat{\section}[block]
  {\normalfont\normalsize\setstretch{1}\bfseries\filcenter}{}{0pt}{}
\titleformat{\subsection}[block]
  {\normalfont\normalsize\setstretch{1}\filcenter}{}{0pt}{}
\titleformat{\subsubsection}[block]
  {\normalfont\normalsize\setstretch{1}\bfseries\filright}{}{0pt}{}
\titleformat{\paragraph}[block]
  {\normalfont\normalsize\setstretch{1}\filright}{}{0pt}{}
% Compensate for the following paragraph's double-spaced baseline so that
% the heading-to-body distance is two single lines, not nearly three.
\newlength\mbts@headgap
% Consecutive headings already carry the preceding heading's after-space.
% Keep the full three-line separation without counting that space twice.
\renewcommand*\ttl@titlespace[1]{\addvspace{\dimexpr#1-\mbts@headgap\relax}}
\titlespacing{\section}{0pt}{\mbtsheadbefore}{\mbts@headgap}
\titlespacing{\subsection}{0pt}{\mbtsheadbefore}{\mbts@headgap}
\titlespacing{\subsubsection}{0pt}{\mbtsheadbefore}{\mbts@headgap}
\titlespacing{\paragraph}{0pt}{\mbtsheadbefore}{\mbts@headgap}

% Footnotes are single spaced, with a first-line indent (not a hanging indent).
\renewcommand*\footnotesize{%
  \@setfontsize\footnotesize{10}{12}}
\renewcommand*\@makefnmark{%
  \hbox{\normalfont\textsuperscript{\@thefnmark}}}
\long\def\@makefntext#1{%
  \raggedright\setlength\parindent{\mbtsindent}%
  \setlength\parskip{0pt}%
  \noindent\hspace*{\mbtsindent}\@makefnmark\nobreak\ #1}
\renewcommand*\pagefootnoterule{%
  \kern-3pt\hrule width \mbtsfootnoterulewidth height .4pt\kern2.6pt}
\let\mpfootnoterule\pagefootnoterule
% footmisc's splitrule supplies a full-width separator on continuation pages.

\AtBeginDocument{%
  \doublespacing
  \setlength\mbts@bodybaseline{\baselineskip}%
  \setlength\mbts@headgap{%
    \dimexpr\mbtsheadafter+\mbtssinglebaseline-\mbts@bodybaseline\relax}%
  \raggedright
  \setlength\parindent{\mbtsindent}%
  \setlength\parskip{0pt}%
  \raggedbottom
  \frenchspacing
  \clubpenalty=10000
  \widowpenalty=10000
  \displaywidowpenalty=10000
  % A strut at the start of each note leaves a blank line between notes.
  \setlength\footnotesep{20.4pt}% 10pt strut height + one 12pt blank line
  \setlength{\skip\footins}{\mbtssinglebaseline}%
  \@ifpackageloaded{hyperref}{\hypersetup{hidelinks}}{}%
}

% Title pages, document divisions, illustrations, and review/annotation helpers.
\RequirePackage{mbts-structure}

% Block quotations retain the body font and indent only the left edge.
\newenvironment{mbtsquote}{%
  \par\addvspace{\mbtssinglebaseline}%
  \begingroup\setstretch{1}
  \list{}{%
    \setlength\leftmargin{\mbtsindent}%
    \setlength\rightmargin{0pt}%
    \setlength\listparindent{\mbtsindent}%
    \setlength\itemindent{0pt}%
    \setlength\topsep{0pt}\setlength\partopsep{0pt}%
    \setlength\parsep{0pt}\setlength\itemsep{0pt}}%
  \item\relax
}{%
  \endlist\endgroup\par\addvspace{\mbtssinglebaseline}\@endpetrue}

% Manual bibliography: supply formatted entries in alphabetical order.
\newcommand*\mbtsbibliographyname{BIBLIOGRAPHY}
\newenvironment{mbtsbibliography}{%
  \clearpage\mbts@majorheading{\mbtsbibliographyname}\mbts@bibcontents%
  \begingroup\setstretch{1}\raggedright
  \list{}{%
    \setlength\leftmargin{\mbtsindent}%
    \setlength\itemindent{-\mbtsindent}%
    \setlength\itemsep{\mbtsentrysep}%
    \setlength\parsep{0pt}\setlength\topsep{0pt}\setlength\partopsep{0pt}}%
}{\endlist\endgroup}
\newcommand\mbtsbibitem[1]{\item\relax #1}

% Bibliography layout; use style=mbts for fourth-edition citation wording.
\AtBeginDocument{%
  \@ifpackageloaded{biblatex}{%
    \defbibheading{mbtsbibliography}[\mbtsbibliographyname]{%
      \clearpage\mbts@majorheading{#1}\mbts@bibcontents}%
    \renewcommand*\bibfont{\normalfont\normalsize\setstretch{1}\raggedright}%
    \setlength\bibhang{\mbtsindent}%
    \setlength\bibitemsep{\mbtsentrysep}%
    \setlength\bibparsep{0pt}%
  }{}%
}
\newcommand*\mbtsprintbibliography[1][]{%
  \@ifpackageloaded{biblatex}{%
    \printbibliography[heading=mbtsbibliography,filter=mbts,#1]}{%
    \PackageError{mbts}{Load biblatex before printing a database bibliography}%
      {Or use the mbtsbibliography environment for manual entries.}}}
\endinput
